      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Failure asymmetry: everything LEFT of raw_events loses data permanently when it breaks — a carrier retries 3 times and gives up.\nEverything RIGHT of raw_events can crash, be redeployed, or be replayed from the start. That is the whole reason the boundary exists.",
      "roughness": 1,
      "roundness": null,
      "seed": 594471366,
      "strokeColor": "#a32d2d",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Failure asymmetry: everything LEFT of raw_events loses data permanently when it breaks — a carrier retries 3 times and gives up.\nEverything RIGHT of raw_events can crash, be redeployed, or be replayed from the start. That is the whole reason the boundary exists.",
